OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
# headlines(연합+중앙) | yna_headlines | joongang_headlines | rss
NEWS_SOURCE=headlines
# politics | general (general은 분야별 1건씩)
NEWS_TOPIC=general
RSS_FEEDS=
NEWS_MAX_ITEMS=5
FETCH_BODY_LIMIT=30
MIN_IMPORTANCE_SCORE=7
# Netlify 프록시 사용 시 CORS 불필요. API를 직접 호출할 때만 설정
CORS_ORIGINS=http://localhost:3456,https://aionelinenews.netlify.app
